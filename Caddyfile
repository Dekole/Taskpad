taskpad.duckdns.org {
    handle /webhook {
        reverse_proxy host.docker.internal:9000
    }

    handle /api/auth/* {
        reverse_proxy backend:8080
    }

    @tasks path /api/tasks /api/tasks/*
    handle @tasks {
        reverse_proxy backend:8080
    }

    @import path /api/import/csv /api/import/csv/*
    handle @import {
        reverse_proxy backend:8080
    }

    handle /api/health {
        reverse_proxy backend:8080
    }

    handle /.well-known/oauth-authorization-server {
        reverse_proxy taskpad-mcp:3000
    }

    handle /mcp {
        reverse_proxy taskpad-mcp:3000
    }

    handle /mcp/* {
        reverse_proxy taskpad-mcp:3000
    }

    handle {
        reverse_proxy frontend:80
    }
}
