# Copy this file to .env and fill in your values

# --- Google OAuth ---
# Download your OAuth client secret JSON from Google Cloud Console
# and place it at ./secrets/client_secret.json
GOOGLE_CLIENT_SECRETS_FILE=/secrets/client_secret.json
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback

# --- Database ---
DATABASE_URL=postgresql://taskapp:dekoletaskapp@db:5432/taskapp

# --- URLs ---
# Set FRONTEND_URL to https://yourdomain.com when deploying publicly
FRONTEND_URL=http://localhost:3000

# --- Vite (frontend) ---
# Must be prefixed with VITE_ to be accessible in the browser
VITE_API_URL=http://localhost:8080
