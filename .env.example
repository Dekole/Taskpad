# Copy this file to .env and fill in your values.
# .env is gitignored and is the only place secrets live in this repo.

# --- Database ---
# POSTGRES_PASSWORD is consumed by the db service via ${POSTGRES_PASSWORD}
# in docker-compose.yml. Keep it out of that file - it is tracked in git.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://taskapp:change-me@db:5432/taskapp

# --- Google OAuth (shared by the app and the MCP server) ---
# Place the OAuth client secret JSON at ./secrets/client_secret.json
GOOGLE_CLIENT_SECRETS_FILE=/secrets/client_secret.json
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAIL=

# --- URLs ---
# Set these to https://yourdomain.com when deploying publicly
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:3003

# --- MCP server ---
# Every one of these is required: docker-compose.yml uses ${VAR:?}, so a
# missing value stops the stack rather than starting a broken container.
MCP_AUTH_TOKEN=
MCP_JWT_SECRET=
TASKPAD_API_URL=http://backend:8080/api
TASKPAD_SERVICE_TOKEN=
TASKPAD_USER_ID=
